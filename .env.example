# Copy to .env and adjust for your machine. Read by flexsym.paths, which is the
# only place a filesystem root is defined.
#
# Roots are kept separate because the bulk data (checkpoints and fixed-point
# output, tens of GB) is expected on an external volume while the repo is not.
# A relative value resolves against the repository root, not the working
# directory, so a module writes to the same place wherever it is invoked from.

# Trained network checkpoints: the size x seed grid and the released networks.
MODEL_ROOT=/Volumes/X9_Pro/flexible_multitask_data

# Processed data released with Driscoll et al. 2024 (Allen Institute buckets).
DATA_ROOT=/Volumes/X9_Pro/flexible_multitask_data/multitask_processed

# The released checkpoints analysed alongside our own grid.
# Defaults to DATA_ROOT/suppfig4.
# ORIGINAL_STORE=

# Our own size x seed training grid, and the cached activity keyed by
# (network, rule). Default to MODEL_ROOT/new_runs/staged and
# MODEL_ROOT/activity_cache.
# STAGED_STORE=
# CACHE_ROOT=

# Where analyses write. Output is split by cohort and the two are never pooled:
# ./results/main is the locally trained grid behind the main text,
# ./results/released the Driscoll networks behind the supplement. Set this to
# the cohort a run should read and write.
RESULTS_ROOT=./results/main

# The directory holding both cohorts, read only by flexsym.supp, which reports
# them side by side. Defaults to ./results.
# RESULTS_STORE=
