# Copy to .env and adjust for your machine. Read by flexsym.paths.
#
# Roots are kept separate because on this setup the bulk data lives on an
# external volume while the repo lives on the internal disk.

# Trained network checkpoints (the size x seed grid, and the released nets)
MODEL_ROOT=/Volumes/X9_Pro/flexible_multitask_data

# Processed data released with Driscoll et al. 2024 (Allen Institute buckets)
DATA_ROOT=/Volumes/X9_Pro/flexible_multitask_data/multitask_processed

# Where analyses write their outputs. Large subtrees (motif_fixed_points,
# motif_fixed_points_response) are symlinks into MODEL_ROOT.
RESULTS_ROOT=./results

# Figure output root
FIGURES_ROOT=./results/figures
