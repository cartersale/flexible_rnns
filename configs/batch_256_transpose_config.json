{
  "description": "Signed-WL structural partition of the transpose-variant recurrent matrix for the 256-unit softplus networks, with per-network k selection. Produces the partition cache every reported analysis reads.",
  "run_name": "batch_256_transpose",
  "activity_root": "results/activity_clusters_paper",
  "struct_root": "results/signed_input_wl_paper",
  "model_globs": [
    "Leaky*_softplus_*_256_all_*"
  ],
  "exclude_models": [],
  "matrix_variant": "transpose",
  "k_min": 3,
  "k_max": 60,
  "saturation_within_fraction": 0.1,
  "batch_size": 1024,
  "wl_null": 1000,
  "wl_n_iter": 20,
  "wl_n_init": 20,
  "seed": 0,
  "activity_clustering": {
    "normalization": "max",
    "linkage_method": "ward",
    "active_threshold": 0.001,
    "output_name": "epoch_variance_unit_clusters_paper_max.npz"
  }
}
